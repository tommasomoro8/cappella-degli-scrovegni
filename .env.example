# Firebase service account used by src/database/database.js to write to Firestore.
# Copy this file to .env and fill it with the values from the JSON key
# (Firebase console > Project settings > Service accounts > Generate new private key).
# The .env file is read only when NODE_ENV is not "production".

TYPE=service_account
PROJECT_ID=your-project-id
PRIVATE_KEY_ID=0000000000000000000000000000000000000000
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
CLIENT_ID=000000000000000000000
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com

# Optional
# PORT=3000
# NODE_ENV=production   # turns on the HTTPS redirect
